#!/bin/bash
# Munin plugin for PHP OPcache stats - ALL containers in a single process (multigraph)
# Version: 2.0.0 - single-process auto-discovering replacement for the
# per-container php_opcache_<container> wildcard plugin.
#
# Emits per container (identical graph names to v1.x, so existing RRDs are
# preserved):
#   php_opcache_memory_<safe_name>
#   php_opcache_keys_<safe_name>
#   php_opcache_interned_strings_<safe_name>
#
# Why this exists: v1.x spawned one plugin process per container and each one
# called cgi-fcgi three times per fetch (plus docker ps + jq per field). With
# ~30 containers that was ~96 PHP-FPM socket hits + ~100 subprocess spawns per
# poll. This version does a single `docker ps`, one `cgi-fcgi` per container
# and minimal JSON parsing, cutting Munin's CPU/process/IO load dramatically.

PLUGIN_NAME="${0##*/}"

get_opcache_stats() {
    local container="$1"
    SCRIPT_NAME=/tmp/opcache-status.php \
    SCRIPT_FILENAME=/tmp/opcache-status.php \
    REQUEST_METHOD=GET \
    cgi-fcgi -bind -connect "/run/php/${container}.sock" 2>&1 | tail -1
}

# Container name -> Munin-safe name (dashes -> underscores)
safe() { echo "${1//-/_}"; }

# Parse all fields with ONE jq call (or a grep fallback without jq) and print a
# tab-separated line:
#   used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size
#   interned_used interned_free
# A single jq per container keeps subprocess spawns low (~42 ms per jq process).
parse_all() {
    local json="$1"
    if command -v jq >/dev/null 2>&1; then
        echo "$json" | jq -r '[.memory_usage.used_memory, .memory_usage.free_memory, .memory_usage.wasted_memory, .memory_usage.current_wasted_percentage, .opcache_statistics.max_cached_keys, .opcache_statistics.num_cached_keys, .interned_strings_usage.buffer_size, .interned_strings_usage.used_memory, .interned_strings_usage.free_memory] | map(if . == null then 0 else . end) | @tsv'
    else
        local used free wasted wp maxk cached ibuf iused ifree
        used=$(echo "$json" | grep -o '"used_memory":[0-9]*' | head -1 | cut -d':' -f2)
        free=$(echo "$json" | grep -o '"free_memory":[0-9]*' | head -1 | cut -d':' -f2)
        wasted=$(echo "$json" | grep -o '"wasted_memory":[0-9]*' | head -1 | cut -d':' -f2)
        wp=$(echo "$json" | grep -o '"current_wasted_percentage":[0-9]*' | head -1 | cut -d':' -f2)
        maxk=$(echo "$json" | grep -o '"max_cached_keys":[0-9]*' | head -1 | cut -d':' -f2)
        cached=$(echo "$json" | grep -o '"num_cached_keys":[0-9]*' | head -1 | cut -d':' -f2)
        ibuf=$(echo "$json" | grep -o '"buffer_size":[0-9]*' | head -1 | cut -d':' -f2)
        iused=$(echo "$json" | grep -o '"used_memory":[0-9]*' | tail -1 | cut -d':' -f2)
        ifree=$(echo "$json" | grep -o '"free_memory":[0-9]*' | tail -1 | cut -d':' -f2)
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "${used:-0}" "${free:-0}" "${wasted:-0}" "${wp:-0}" "${maxk:-0}" "${cached:-0}" "${ibuf:-0}" "${iused:-0}" "${ifree:-0}"
    fi
}

# Discover running containers that expose a PHP-FPM FastCGI socket
php_containers() {
    local c
    for c in $(docker ps --format '{{.Names}}' 2>/dev/null); do
        if [ -S "/run/php/${c}.sock" ]; then
            echo "$c"
        fi
    done
}

do_memory_config() {
    local container="$1" json="$2"
    local safe_name used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size iused ifree
    local total_memory free_critical wasted_critical used_warning used_critical
    safe_name=$(safe "$container")

    IFS=$'\t' read -r used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size iused ifree <<< "$(parse_all "$json")"
    total_memory=$((used_mem + free_mem + wasted_mem))
    if [ "$total_memory" -eq 0 ]; then
        total_memory=268435456
    fi

    # Thresholds for real problems
    free_critical=$((total_memory * 1 / 100))   # 1% of total is truly critical
    wasted_critical=30                           # 30% is untenable

    # Desired warnings for the used percentage
    used_warning=95
    used_critical=98

    cat <<EOF
multigraph php_opcache_memory_${safe_name}
graph_title PHP OPcache memory usage - ${container}
graph_args --base 1024 -l 0
graph_vlabel bytes
graph_category php-opcache
graph_info OPcache memory usage for ${container}
graph_order used free wasted total used_perc wasted_perc

used.label Used memory
used.type GAUGE
used.min 0
used.draw AREA
used.colour 44AD4E
used.info Currently used OPcache memory

free.label Free memory
free.type GAUGE
free.min 0
free.draw STACK
free.colour 6BAED6
free.critical ${free_critical}:
free.info Available OPcache memory (CRITICAL if below 1% of total)

wasted.label Wasted memory
wasted.type GAUGE
wasted.min 0
wasted.draw STACK
wasted.colour DD4B39
wasted.info Memory from outdated scripts (reclaimed automatically when needed)

total.label Total memory
total.type GAUGE
total.min 0
total.draw LINE2
total.colour 999999
total.info Total OPcache memory available

used_perc.label Used percentage
used_perc.type GAUGE
used_perc.min 0
used_perc.max 100
used_perc.warning ${used_warning}
used_perc.critical ${used_critical}
used_perc.info Percentage of total memory used (WARNING if >${used_warning}%%, CRITICAL if >${used_critical}%%)

wasted_perc.label Wasted percentage
wasted_perc.type GAUGE
wasted_perc.min 0
wasted_perc.max 100
wasted_perc.critical ${wasted_critical}
wasted_perc.info Wasted memory as percentage (CRITICAL only if >${wasted_critical}%% - manual intervention needed)
EOF
}

do_keys_config() {
    local container="$1" json="$2"
    local safe_name max_keys
    local used_mem free_mem wasted_mem wasted_perc cached_keys buffer_size iused ifree
    safe_name=$(safe "$container")
    IFS=$'\t' read -r used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size iused ifree <<< "$(parse_all "$json")"
    if [ "$max_keys" -eq 0 ]; then
        max_keys=16229
    fi

    cat <<EOF
multigraph php_opcache_keys_${safe_name}
graph_title PHP OPcache keys usage - ${container}
graph_args -l 0
graph_vlabel keys
graph_category php-opcache
graph_info OPcache keys usage for ${container}
graph_order cached free max

cached.label Cached keys
cached.type GAUGE
cached.min 0
cached.draw AREA
cached.colour 44AD4E
cached.info Number of currently cached keys

free.label Free slots
free.type GAUGE
free.min 0
free.draw STACK
free.colour 6BAED6
free.info Available key slots (max - cached)

max.label Max keys (total)
max.type GAUGE
max.min 0
max.draw LINE2
max.colour 999999
max.info Maximum number of keys allowed (opcache.max_accelerated_files)
EOF
}

do_interned_strings_config() {
    local container="$1" json="$2"
    local safe_name buffer_size warn_bytes crit_bytes
    local used_mem free_mem wasted_mem wasted_perc max_keys cached_keys iused ifree
    safe_name=$(safe "$container")
    IFS=$'\t' read -r used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size iused ifree <<< "$(parse_all "$json")"
    if [ "$buffer_size" -eq 0 ]; then
        buffer_size=33554432
    fi
    warn_bytes=$((buffer_size * 10 / 100))
    crit_bytes=$((buffer_size * 5 / 100))

    cat <<EOF
multigraph php_opcache_interned_strings_${safe_name}
graph_title PHP OPcache interned strings - ${container}
graph_args --base 1024 -l 0
graph_vlabel bytes
graph_category php-opcache
graph_info OPcache interned strings buffer for ${container}. Shows when buffer is nearly full.
graph_order used free total

used.label Used memory
used.type GAUGE
used.min 0
used.draw AREA
used.colour 44AD4E
used.info Currently used interned strings memory

free.label Free memory
free.type GAUGE
free.min 0
free.draw STACK
free.colour 6BAED6
free.warning ${warn_bytes}:
free.critical ${crit_bytes}:
free.info Available interned strings memory (warning if below 10%, critical if below 5%)

total.label Total buffer size
total.type GAUGE
total.min 0
total.draw LINE2
total.colour 999999
total.info Total interned strings buffer size (opcache.interned_strings_buffer)
EOF
}

do_memory_values() {
    local container="$1" json="$2"
    local safe_name used_mem free_mem wasted_mem wasted_perc total_mem used_perc
    local max_keys cached_keys buffer_size iused ifree
    safe_name=$(safe "$container")

    IFS=$'\t' read -r used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size iused ifree <<< "$(parse_all "$json")"
    total_mem=$((used_mem + free_mem + wasted_mem))

    used_perc=0
    if [ "$total_mem" -gt 0 ]; then
        used_perc=$((used_mem * 100 / total_mem))
    fi

    echo "multigraph php_opcache_memory_${safe_name}"
    echo "used.value ${used_mem}"
    echo "free.value ${free_mem}"
    echo "wasted.value ${wasted_mem}"
    echo "total.value ${total_mem}"
    echo "used_perc.value ${used_perc}"
    echo "wasted_perc.value ${wasted_perc}"
}

do_keys_values() {
    local container="$1" json="$2"
    local safe_name max_keys cached_keys free_keys
    local used_mem free_mem wasted_mem wasted_perc buffer_size iused ifree
    safe_name=$(safe "$container")

    IFS=$'\t' read -r used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size iused ifree <<< "$(parse_all "$json")"
    [ "$max_keys" -eq 0 ] && max_keys=16229
    free_keys=$((max_keys - cached_keys))

    echo "multigraph php_opcache_keys_${safe_name}"
    echo "cached.value ${cached_keys}"
    echo "free.value ${free_keys}"
    echo "max.value ${max_keys}"
}

do_interned_strings_values() {
    local container="$1" json="$2"
    local safe_name buffer_size used_mem free_mem
    local wasted_mem wasted_perc max_keys cached_keys iused ifree
    safe_name=$(safe "$container")

    IFS=$'\t' read -r used_mem free_mem wasted_mem wasted_perc max_keys cached_keys buffer_size iused ifree <<< "$(parse_all "$json")"

    if [ "$buffer_size" -eq 0 ]; then
        buffer_size=33554432
        if [ "$used_mem" -eq 0 ] && [ "$free_mem" -eq 0 ]; then
            used_mem=0
            free_mem=$buffer_size
        fi
    fi

    echo "multigraph php_opcache_interned_strings_${safe_name}"
    echo "used.value ${used_mem}"
    echo "free.value ${free_mem}"
    echo "total.value ${buffer_size}"
}

case "$1" in
    config)
        for c in $(php_containers); do
            json=$(get_opcache_stats "$c")
            do_memory_config "$c" "$json"
            echo
            do_keys_config "$c" "$json"
            echo
            do_interned_strings_config "$c" "$json"
            echo
        done
        ;;
    *)
        for c in $(php_containers); do
            json=$(get_opcache_stats "$c")
            do_memory_values "$c" "$json"
            echo
            do_keys_values "$c" "$json"
            echo
            do_interned_strings_values "$c" "$json"
            echo
        done
        ;;
esac
